# ============================================================================
# Last247 frontend environment configuration
#
# PUBLIC — this project has NO secrets. NEXT_PUBLIC_* values are inlined into
# the client bundle at build time and visible to anyone. All credentials
# (Turso, provider API keys, LLMPing token) live ONLY in the backend env
# (OrcaDeLast247/.env — gitignored). Never add secret variables here.
# ============================================================================

# Base URL of the Last247 Python backend (FastAPI — see UI_API_INTEGRATION.md §2).
# All API paths are relative to this base URL.
# Deployed (Render): https://orcadelast247.onrender.com
# Local dev: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=https://orcadelast247.onrender.com
